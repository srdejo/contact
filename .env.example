PORT=3000

# Resend — usado por POST /api/contact (formulario público de Mi Casa Church)
RESEND_API_KEY=re_xxxxxxxxx
MAIL_FROM=Acme <onboarding@resend.dev>
MAIL_TO=delivered@resend.dev

# Gmail SMTP (contraseña de aplicación, no la clave normal de la cuenta) —
# usado por POST /api/send (uso interno, ver README: hotel-backend, consulting)
GMAIL_USER=
GMAIL_APP_PASSWORD=
GMAIL_FROM=

# WhatsApp (Baileys / WhatsApp Web multi-dispositivo)
# No hay token: la sesion se crea escaneando un QR la primera vez y queda
# guardada en data/whatsapp/auth/ (gitignoreada). Ver README > WhatsApp.
# Numero que recibe la notificacion de /api/contact, solo digitos con indicativo.
WHATSAPP_TO_NUMBER=573000000000
