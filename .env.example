PORT=3000

# Resend — usado por POST /api/contact (formulario público de Mi Casa Church)
RESEND_API_KEY=re_xxxxxxxxx
MAIL_FROM=Acme <onboarding@resend.dev>
MAIL_TO=delivered@resend.dev

# Gmail SMTP (contraseña de aplicación, no la clave normal de la cuenta) —
# usado por POST /api/send (uso interno, ver README: hotel-backend, consulting)
GMAIL_USER=
GMAIL_APP_PASSWORD=
GMAIL_FROM=

# --- WhatsApp -----------------------------------------------------------------
# Hay DOS numeros de WhatsApp:
#   1. El numero dedicado: el que esta vinculado a este servicio (el QR que se
#      escanea la primera vez) y al que escriben los reclutadores. No va aqui:
#      su sesion queda guardada en data/whatsapp/auth/. Ver README > WhatsApp.
#   2. Tu numero personal: el de abajo. Ahi te llegan los avisos.

# Tu numero personal: recibe el aviso de /api/contact. Solo digitos, con
# indicativo, sin + ni espacios. Sus chats nunca se le pasan a PERLA.
WHATSAPP_TO_NUMBER=573000000000

# --- PERLA (el asistente que contesta en el numero dedicado) ------------------
# A donde se le pasa a PERLA cada mensaje que llega al numero dedicado.
# Vacio = no se le pasa nada y el servicio funciona como antes.
# En el VPS, cuando PERLA ya tenga el canal de WhatsApp listo, poner:
#   PERLA_EVENTS_URL=http://127.0.0.1:8084/internal/whatsapp/events
PERLA_EVENTS_URL=

# Contrasena que inventas tu y pones IGUAL en los dos .env: aqui y en el de
# PERLA (alli se llama WHATSAPP_CHANNEL_SECRET). Con ella PERLA sabe que el
# mensaje viene de este servicio; si no coinciden, PERLA rechaza los mensajes.
PERLA_CHANNEL_SECRET=
